# Claves PÚBLICAS de RevenueCat (SDK). Nunca pongas aquí claves secretas.
EXPO_PUBLIC_RC_IOS_KEY=appl_xxxxxxxxxxxxxxxxxxxxxxxx
EXPO_PUBLIC_RC_ANDROID_KEY=goog_xxxxxxxxxxxxxxxxxxxxxxxx

# Supabase: ya configurado en src/config/app.ts (proyecto «vytron»). Solo si cambias de proyecto:
# EXPO_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
# EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Web pública (privacidad, términos y soporte se sirven desde public/).
EXPO_PUBLIC_SITE_URL=https://vytron-eta.vercel.app

# AdMob (solo plan Free). Sin estas variables se usan los IDs de prueba de Google.
ADMOB_IOS_APP_ID=ca-app-pub-xxxxxxxxxxxxxxxx~xxxxxxxxxx
ADMOB_ANDROID_APP_ID=ca-app-pub-xxxxxxxxxxxxxxxx~xxxxxxxxxx
EXPO_PUBLIC_ADMOB_BANNER_IOS=ca-app-pub-xxxxxxxxxxxxxxxx/xxxxxxxxxx
EXPO_PUBLIC_ADMOB_BANNER_ANDROID=ca-app-pub-xxxxxxxxxxxxxxxx/xxxxxxxxxx

# Las claves secretas (ANTHROPIC_API_KEY, REVENUECAT_SECRET_KEY) van SOLO en los
# secretos de Supabase: supabase secrets set ANTHROPIC_API_KEY=... REVENUECAT_SECRET_KEY=...
