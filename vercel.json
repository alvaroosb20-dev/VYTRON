{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm install",
  "buildCommand": "npx expo export --platform web",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/"
    }
  ],
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/condiciones",
      "destination": "/terminos",
      "permanent": true
    },
    {
      "source": "/terminos-y-condiciones",
      "destination": "/terminos",
      "permanent": true
    }
  ]
}
